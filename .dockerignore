# The build context is 644 MB without this, 643 MB of which is .venv - shipped
# to the daemon on every single build. The container builds its own
# environment from requirements.txt; the host's venv is not just useless
# inside the image, it is actively wrong (Windows paths, Windows wheels).
.venv/
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore

# generated locally, regenerated by the study scripts on demand
reports/*.log
reports/*.png
reports/artifacts/
docs/stack_*.log

# test corpus and offline training datasets (keeps zoo code and models/classifier.txt intact)
zoo/corpus/
models/dataset_*.csv

# uploads and runtime databases
uploads/
*.db
*.db-*
raaya.db*

# frontend host artifacts
web/node_modules/
web/dist/

# editors / OS
.DS_Store
.vscode/
.idea/
